{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "nodeVersion": "18.x",
  "env": [
    {
      "key": "DATABASE_URL",
      "description": "PostgreSQL database URL",
      "value": ""
    },
    {
      "key": "NEXTAUTH_SECRET",
      "description": "NextAuth secret key",
      "value": ""
    },
    {
      "key": "NEXTAUTH_URL",
      "description": "NextAuth URL",
      "value": "@vercel_url"
    }
  ]
}
